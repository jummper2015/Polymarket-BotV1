# ============================================================
#  Polymarket BTC Up/Down 5m Bot — variables de entorno
#  Copiar este archivo a .env y completar los valores.
#  En Replit usar Tools → Secrets en lugar de este archivo.
# ============================================================

# ------------------------------------------------------------
# MODO DE OPERACIÓN
# ------------------------------------------------------------
# "paper"  → simulación sin fondos reales (por defecto)
# "real"   → opera con fondos reales; requiere PRIVATE_KEY y PROXY_WALLET
TRADING_MODE=paper

# ------------------------------------------------------------
# CREDENCIALES (solo necesarias para TRADING_MODE=real)
# ------------------------------------------------------------
# Clave privada de la wallet Polygon usada en Polymarket
# NUNCA compartir ni subir a un repositorio público
PRIVATE_KEY=

# Dirección del proxy wallet de Polymarket (empieza con 0x)
PROXY_WALLET=

# ------------------------------------------------------------
# ESTRATEGIA
# ------------------------------------------------------------
# Precio mínimo de un token para disparar la compra (0.01 – 0.99)
TRIGGER_PRICE=0.90

# USDC a invertir por operación
BUY_AMOUNT=5.0

# Bankroll inicial para el cálculo de P&L en el dashboard
STARTING_BANKROLL=1000.0

# Máximo de posiciones iniciales por ventana de 5 minutos (1 – 10)
MAX_TRADES_PER_WINDOW=1

# Precio al que se activa la cobertura del lado contrario (0.50 – 0.99)
HEDGE_THRESHOLD=0.96

# Segundos antes del cierre de ventana en los que el bot empieza a vigilar
# Las entradas solo se abren en los primeros 45 s de esta ventana (10 – 240)
LAST_MINUTE_SECONDS=60

# ------------------------------------------------------------
# DASHBOARD
# ------------------------------------------------------------
# Puerto del servidor web
PORT=5000

# Host de escucha (0.0.0.0 para aceptar conexiones externas)
DASHBOARD_HOST=0.0.0.0

# ------------------------------------------------------------
# POLYMARKET API (no cambiar salvo que Polymarket cambie sus endpoints)
# ------------------------------------------------------------
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ------------------------------------------------------------
# BLOCKCHAIN (Polygon mainnet)
# ------------------------------------------------------------
# 137 = Polygon mainnet
CHAIN_ID=137

# 2 = proxy wallet (modo estándar de Polymarket)
SIGNATURE_TYPE=2
DASHBOARD_API_KEY=cego
# ------------------------------------------------------------
# TUNING AVANZADO (valores por defecto recomendados)
# ------------------------------------------------------------
# Intervalo del loop de trading en milisegundos
POLL_INTERVAL_MS=50

# Segundos entre reintentos al cargar el mercado de la ventana actual
MARKET_RETRY_SECONDS=3

# Segundos de espera para recibir el primer precio del WebSocket
FIRST_PRICE_TIMEOUT=5

# ------------------------------------------------------------
# CHAINLINK TWAP (docs/CHAINLINK_TWAP.md)
# ------------------------------------------------------------
# Feeds TWAP de Chainlink vía el relay de Polymarket (sin credenciales).
# Sirven como FILTRO anti-manipulación, no para liquidar: los mercados
# resuelven contra el stream normal btc-usd, que es otro feed distinto.
# Los topics se activaron el 4-ago-2026; antes devuelven 500.
CL_TWAP_ENABLED=false

# Ventana del TWAP para la señal: solo existen 30 y 60 segundos
CL_TWAP_WINDOW=30

# Descartar ticks más viejos que esto. Chainlink no publica cadencia ni SLA,
# así que el umbral no es opcional. Calibrar con la edad real observada.
CL_TWAP_STALE_SECONDS=15

# Veto por divergencia |spot - twap| / twap. 0 = desactivado.
# NO activar sin calibrar sobre semanas de tape grabado.
CL_DIVERGENCE_MAX=0

# Grabar los ticks en la tabla chainlink_ticks. Chainlink no sirve histórico:
# lo que no se grabe hoy se pierde para siempre.
CL_RECORD_TICKS=false

# Días de retención del tape. ~172.800 filas/día — sin purga llena el disco.
CL_TICK_RETENTION_DAYS=30

# ------------------------------------------------------------
# ACCESO AL DASHBOARD
# ------------------------------------------------------------
# El dashboard puede cambiar el bot de paper a REAL, así que sin contraseña
# solo se permite escuchar en 127.0.0.1. Si DASHBOARD_HOST=0.0.0.0 y no hay
# contraseña, el bot se niega a arrancar.
DASHBOARD_PASSWORD=

# Clave para firmar la cookie de sesión. Si se deja vacía se genera una al
# arrancar y las sesiones se cierran en cada reinicio.
#   Generar:  python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=
