# ============================================================
#  Polymarket BTC Up/Down 5m Bot — variables de entorno
#  Copiar este archivo a .env y completar los valores.
#  En Replit usar Tools → Secrets en lugar de este archivo.
# ============================================================

# ------------------------------------------------------------
# MODO DE OPERACIÓN
# ------------------------------------------------------------
# "paper"  → simulación sin fondos reales (por defecto)
# "real"   → opera con fondos reales; requiere PRIVATE_KEY y PROXY_WALLET
TRADING_MODE=paper

# ------------------------------------------------------------
# CREDENCIALES (solo necesarias para TRADING_MODE=real)
# ------------------------------------------------------------
# Clave privada de la wallet Polygon usada en Polymarket
# NUNCA compartir ni subir a un repositorio público
PRIVATE_KEY=

# Dirección del proxy wallet de Polymarket (empieza con 0x)
PROXY_WALLET=

# ------------------------------------------------------------
# ESTRATEGIA — Streak Snapper
# ------------------------------------------------------------
# Bankroll inicial para el cálculo de P&L en el dashboard
STARTING_BANKROLL=1000.0

# Interruptor general de la estrategia
SS_ENABLED=true

# Mercados a operar, separados por comas. Un hilo por mercado, cada uno con su
# propio ciclo de martingala y sus propias operaciones.
# Soportados: btc, eth, sol — los tres cotizan con spread de 1 centavo.
# (XRP y DOGE también tienen mercado de 5m, pero con 3-6 centavos de spread se
#  comen el edge medido, que es inferior a 2 centavos.)
#
# ⚠️ Añadir mercados NO multiplica la muestra independiente: los tres activos se
#    mueven juntos, así que sus señales están correlacionadas. Acelera la
#    validación, pero menos de lo que sugiere el número de operaciones.
SS_SYMBOLS=btc

# Qué formas operan: "fade" | "trend" | "both"
# ⚠️ "fade", no "both": medido sobre 3.734 ventanas con cotización previa a la
#    apertura, ss_trend pierde −4,22% por operación (−7,08% excluyendo ventanas
#    con racha, t=−2,61). Apuesta a continuación y las ventanas de 5 min
#    revierten. Ver docs/RUTA.md, Fase 8.
SS_MODE=fade

# ── Forma 1 — Fade (apuesta CONTRA la racha) ──
SS_FADE_BASE_SHARES=5.0
# 0,52 y no 0,60. La señal acierta el 53,8%, así que su precio justo es 0,538:
# pagar 0,60 son 6,2 puntos de pérdida comprados a propósito. Las 5 operaciones
# reales de ss_fade en la DB entraron a 0,558 de media.
SS_FADE_LIMIT_CAP=0.52
# Ventanas de 5 min seguidas en la misma dirección antes de entrar
SS_FADE_STREAK_MIN=4

# ── Forma 2 — Trend (ciclo de 4h en un solo lado) ──
SS_TREND_BASE_SHARES=5.0
SS_TREND_LIMIT_CAP=0.52

# Movimiento mínimo de la vela 4h YA CERRADA para operar su lado durante las
# 4h siguientes (0.008 = 0,8%). Por debajo, ese bloque no se opera.
# ⚠️ Medido sobre 10.000 ventanas: esta señal NO tiene edge (win rate 47–49%
#    en todos los umbrales). 0,8% se elige porque su peor caso (−$892 de
#    drawdown) cabe en el bankroll por defecto, no por rentabilidad.
#    Ver docs/RUTA.md, Fase 4.7.
SS_TREND_MIN_STRENGTH=0.008

# ── Tamaño de la apuesta ──
# "flat"       → siempre SS_*_BASE_SHARES (por defecto)
# "kelly"      → fracción de Kelly sobre el edge medido y el bankroll actual
# "martingale" → comportamiento antiguo: multiplica al perder
#
# ⚠️ "flat" por defecto: una martingala cambia la varianza, nunca el valor
#    esperado. El edge medido justifica ~4% del bankroll por operación (Kelly);
#    el backtest de la martingala llega a apostar $983 en una sola ventana.
SS_SIZING=flat

# Fracción de Kelly a usar cuando SS_SIZING=kelly. 0,25 = cuarto de Kelly.
# Kelly completo sobre un edge con t=+1,32 dimensionaría una hipótesis sin
# confirmar como si fuese certeza.
SS_KELLY_FRACTION=0.25

# ── Martingale (solo si SS_SIZING=martingale) ──
# Un ciclo solo se recupera si el factor > 1/(1-precio_máximo): 2,083 a 0,52 y
# 2,5 a 0,60. Con ×1,5 «seguir hasta ganar» AGRANDA la pérdida desde el tercer
# intento. El bot avisa al arrancar si el factor no recupera.
SS_MARTINGALE_MULT=2.1

# ------------------------------------------------------------
# FILTROS DE RÉGIMEN (bot/regime.py) — todos apagados por defecto
# ------------------------------------------------------------
# Medido sobre 35 días (docs/RUTA.md, Fase 8). Ninguno alcanza significancia:
# se probaron ~20 filtros, así que el mejor parece bueno por construcción.
# Se dejan apagados para que el dashboard compare "con" contra "sin" en vivo.

# Franjas horarias UTC en las que se permite operar. Vacío = todas.
# Formato: "13-21" o "13-21,22-24". Admite cruzar medianoche: "22-2".
#   franja US 13-21h UTC  →  +9,22% (positivo en los 4 tramos de 8,8 días)
#   franja Europa 08-13h  →  −5,00%
SS_TRADING_HOURS=

# Banda de volatilidad: percentiles del ATR de 1h sobre sus últimos 2 días.
# 0 y 100 = sin restricción.
# ⚠️ Es una BANDA, no un techo. "Operar en la máxima calma" empeora el
#    resultado: el cuartil de menor volatilidad mide −0,46%, porque en un
#    mercado plano una racha de 4 ventanas es ruido. La banda media (25-75)
#    mide +6,44%.
SS_VOL_MIN_PCT=0
SS_VOL_MAX_PCT=100

# Percentil máximo del rango de 2h. 100 = sin restricción.
# El rango estrecho (por debajo del percentil 30) mide +6,06%.
SS_RANGE_MAX_PCT=100

# Segundos de ventana ya transcurridos a partir de los cuales NO se abre
# posición. A diferencia de los filtros de arriba, este viene ENCENDIDO.
#
# Una entrada tardía está adversamente seleccionada por construcción: el
# límite de precio deja fuera al favorito, así que el único lado que puede
# llenarse es el que el mercado ya da por perdido. Visto en paper: arrancar
# el bot a los 182 s de ventana compró DOWN a $0,06.
#
# En marcha normal el bot entra a los pocos segundos del boundary, así que
# esto solo actúa tras un reinicio o una carga de mercado lenta.
# Medido (Fase 8): +4,67% al precio previo a la apertura, +1,71% a los 60 s.
SS_MAX_ENTRY_AGE=60

# ------------------------------------------------------------
# FASE B — Box Builder (bot/strategies/box_builder.py)
# ------------------------------------------------------------
# Maker de dos lados: reposa bids post-only en UP y DOWN en la primera mitad
# de la ventana (suma ≤ BB_BID_SUM_CAP). Si ambas patas se llenan el par
# redime a $1,00 sin riesgo direccional (≥ 6 c/par).
# Evidencia: trader 0x3c58ef…776b, $9k P&L, 94k predicciones.
# Apagado por defecto — activar con BB_ENABLED=true en real mode.
BB_ENABLED=false

# Shares por pata. Mismo número en UP y DOWN para que el par redima limpio.
# Mínimo Polymarket: 5. No subir más de 20 hasta tener 100 ventanas en el CSV.
BB_SHARES_PER_LEG=5.0

# Suma máxima de bids (precio_UP + precio_DOWN ≤ este valor).
# 0,94 → ≥ 6 c por par garantizados. Nunca subir por encima de 0,98.
BB_BID_SUM_CAP=0.94

# ask_UP + ask_DOWN debe ser ≥ esto al abrir la ventana para armar los bids.
# Libro estrecho = selección adversa = no cotizar.
BB_ARM_MIN_SPREAD=1.03

# Levantar el otro ask (taker) si es ≤ BB_COMPLETE_TAKER_CAP − p1.
BB_COMPLETE_TAKER_CAP=0.99

# Subir el otro bid (maker) a ≤ BB_COMPLETE_MAKER_CAP − p1.
BB_COMPLETE_MAKER_CAP=0.97

# No colocar nuevas citas de dos lados después de T-BB_QUOTE_CUTOFF_SEC.
# Las citas tardías nunca se llenan (v5: 0 fills en 35 ventanas a T-89).
BB_QUOTE_CUTOFF_SEC=150

# Decisión COA a T-BB_BAILOUT_SEC si una pata está descubierta.
BB_BAILOUT_SEC=90

# Cancelar todas las órdenes restantes a T-BB_CANCEL_ALL_SEC.
BB_CANCEL_ALL_SEC=10

# Re-cotizar a lo sumo cada BB_REPRICE_INTERVAL segundos.
BB_REPRICE_INTERVAL=20

# Solo re-cotizar si la pata está > BB_REPRICE_BEHIND por detrás del mejor bid.
BB_REPRICE_BEHIND=0.02

# Mantener pata descubierta en bailout solo si COA ≥ BB_MIN_COA_HOLD.
BB_MIN_COA_HOLD=1.0

# ------------------------------------------------------------
# FASE B — Coin-Flip Dog (bot/strategies/coin_flip_dog.py)
# ------------------------------------------------------------
# Estrategia basada en la tesis observada en traders de Polymarket con
# rentabilidad medida (zhengying9999 +$16k/mes, hurrican1). Entra en el lado
# barato (underdog) de ventanas BTC de 5 min cuando la ventana está cerca de
# un coin-flip (coa ≤ 0,20) y el ask del underdog está en [0,22, 0,47].
# Entra entre T-90 y T-30 (con 30–90 s restantes en la ventana).
# Evidencia: flip_harvester_IDEA.md — n=10.180, 42,4% win, +14,6% ROI.
# Apagada por defecto — activar con CFD_ENABLED=true.
CFD_ENABLED=false

# Tamaño de la apuesta base en dólares. Las shares = round(apuesta / ask).
CFD_BASE_BET=5.0

# Banda de ask del underdog en la que se opera.
# Por debajo de 0,22: el descuento ya está correctamente priced.
# Por encima de 0,47: la ventaja desaparece (ver flip_harvester_IDEA.md).
CFD_MIN_ASK=0.22
CFD_MAX_ASK=0.47

# Máximo COA (cushion / ATR4). Verifica que la ventana sea near-coin-flip.
CFD_MAX_COA=0.20

# Ventana temporal de entrada (segundos antes del cierre).
# Antes de T-90 la señal no se ha desarrollado; después de T-30 queda poco
# tiempo para la reversión.
CFD_ENTRY_MIN_LEFT=30
CFD_ENTRY_MAX_LEFT=90

# ------------------------------------------------------------
# DASHBOARD
# ------------------------------------------------------------
# Puerto del servidor web
PORT=5000

# Host de escucha (0.0.0.0 para aceptar conexiones externas)
DASHBOARD_HOST=0.0.0.0

# ------------------------------------------------------------
# POLYMARKET API (no cambiar salvo que Polymarket cambie sus endpoints)
# ------------------------------------------------------------
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ------------------------------------------------------------
# BLOCKCHAIN (Polygon mainnet)
# ------------------------------------------------------------
# 137 = Polygon mainnet
CHAIN_ID=137

# 2 = proxy wallet (modo estándar de Polymarket)
SIGNATURE_TYPE=2

# ------------------------------------------------------------
# TUNING AVANZADO (valores por defecto recomendados)
# ------------------------------------------------------------
# Intervalo del loop de trading en milisegundos
POLL_INTERVAL_MS=50

# Segundos entre reintentos al cargar el mercado de la ventana actual
MARKET_RETRY_SECONDS=3

# Segundos de espera para recibir el primer precio del WebSocket
FIRST_PRICE_TIMEOUT=5

# ------------------------------------------------------------
# CHAINLINK TWAP (docs/CHAINLINK_TWAP.md)
# ------------------------------------------------------------
# Feeds TWAP de Chainlink vía el relay de Polymarket (sin credenciales).
# Sirven como FILTRO anti-manipulación, no para liquidar: los mercados
# resuelven contra el stream normal btc-usd, que es otro feed distinto.
# Los topics se activaron el 4-ago-2026; antes devuelven 500.
CL_TWAP_ENABLED=false

# Ventana del TWAP para la señal: solo existen 30 y 60 segundos
CL_TWAP_WINDOW=30

# Descartar ticks más viejos que esto. Chainlink no publica cadencia ni SLA,
# así que el umbral no es opcional. Calibrar con la edad real observada.
CL_TWAP_STALE_SECONDS=15

# Veto por divergencia |spot - twap| / twap. 0 = desactivado.
# NO activar sin calibrar sobre semanas de tape grabado.
CL_DIVERGENCE_MAX=0

# Grabar los ticks en la tabla chainlink_ticks. Chainlink no sirve histórico:
# lo que no se grabe hoy se pierde para siempre.
CL_RECORD_TICKS=false

# Días de retención del tape. ~172.800 filas/día — sin purga llena el disco.
CL_TICK_RETENTION_DAYS=30

# ------------------------------------------------------------
# ACCESO AL DASHBOARD
# ------------------------------------------------------------
# El dashboard puede cambiar el bot de paper a REAL, así que sin contraseña
# solo se permite escuchar en 127.0.0.1. Si DASHBOARD_HOST=0.0.0.0 y no hay
# contraseña, el bot se niega a arrancar.
DASHBOARD_PASSWORD=Ceg0@123

# Clave para firmar la cookie de sesión. Si se deja vacía se genera una al
# arrancar y las sesiones se cierran en cada reinicio.
#   Generar:  python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=
